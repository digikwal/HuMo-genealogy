# Change both passwords before deploying HuMo-genealogy.
DB_PASSWORD=change-this-database-password
DB_ROOT_PASSWORD=change-this-root-password

# Optional overrides
DB_NAME=humogen
DB_USER=humogen
HUMOGEN_PORT=8080

# Optional: fixed trusted origin for canonical and password-reset URLs.
# HUMOGEN_PUBLIC_ORIGIN=https://genealogy.example.com

# Enable only when HuMo-genealogy is exclusively reached through a trusted
# reverse proxy that sets X-Forwarded-Host and X-Forwarded-Proto.
HUMOGEN_TRUST_PROXY_HEADERS=false
