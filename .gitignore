# Project-local test files
/tests/

# Local environment and secrets
.env
.env.*
!.env.example

# IDE and operating-system files
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Local logs and tool caches
*.log
.phpunit.result.cache
.php-cs-fixer.cache

# Runtime-generated backups and GEDCOM uploads
/admin/backup_files/*
!/admin/backup_files/readme.txt
/admin/gedcom_files/*
!/admin/gedcom_files/readme.txt
!/admin/gedcom_files/HuMo-genealogy test gedcomfile.ged

# Runtime-generated reports
/tmp_files/*
!/tmp_files/readme.txt

# User-uploaded media; retain the tracked directory placeholders
/media/*
!/media/readme.txt
!/media/cms/
/media/cms/*
!/media/cms/readme.txt
!/media/slideshow/
/media/slideshow/*
!/media/slideshow/readme.txt
!/media/thumbs/
/media/thumbs/*
!/media/thumbs/readme.txt
